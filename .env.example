# Giscus comments (https://giscus.app) - fill these after enabling Discussions
# on your GitHub repo and installing the giscus app. Comments stay hidden until set.
NEXT_PUBLIC_GISCUS_REPO=your-username/your-blog-repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
